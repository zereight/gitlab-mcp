GITLAB_PERSONAL_ACCESS_TOKEN=<YOUR_GITLAB_TOKEN>
# Change for self-hosted GitLab, e.g. https://gitlab.example.com/api/v4
GITLAB_API_URL=https://gitlab.com/api/v4

# Optional: default project
GITLAB_PROJECT_ID=

# Optional: comma-separated list of allowed project IDs
GITLAB_ALLOWED_PROJECT_IDS=

# Optional tool exposure: readonly, modify, or full. Unset defaults to full.
# GITLAB_PERMISSION_MODE=

# Optional comma-separated toolsets. Include core to preserve the default tools.
# GITLAB_TOOLSETS=core,wiki

# Listen on all container interfaces so the published port is reachable
HOST=0.0.0.0

# use streamable-http (clients connect to http://localhost:3002/mcp)
STREAMABLE_HTTP=true
# Required with GITLAB_PERSONAL_ACCESS_TOKEN: clients send "Authorization: Bearer <token>".
# Set a unique value before starting. Generate one with: openssl rand -hex 32
STREAMABLE_HTTP_AUTH_TOKEN=
# Or let each client send its own GitLab token instead of using the token above
# (remove GITLAB_PERSONAL_ACCESS_TOKEN and STREAMABLE_HTTP_AUTH_TOKEN):
# REMOTE_AUTHORIZATION=true

# use sse (legacy; clients connect to http://localhost:3002/sse)
# SSE=true
# SSE_AUTH_TOKEN=

# Optional response masking. Rules in docker/masking-config are mounted read-only.
# GITLAB_MASKING_ENABLED=true
GITLAB_MASKING_CONFIG=.gitlab-mcp-mask.json
# GITLAB_MASKING_POLICY_FILE=managed-policies.json
